    "Tibber rejected the access token. Create a new one at developer.tibber.com.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibber afviste adgangstokenet. Opret et nyt på developer.tibber.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibber hat das Token abgelehnt. Erstelle ein neues auf developer.tibber.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibber ha rechazado el token de acceso. Crea uno nuevo en developer.tibber.com."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibber hylkäsi käyttötunnuksen. Luo uusi osoitteessa developer.tibber.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibber a refusé le jeton d'accès. Créez-en un nouveau sur developer.tibber.com."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibber ha rifiutato il token di accesso. Creane uno nuovo su developer.tibber.com."
          }
        },
