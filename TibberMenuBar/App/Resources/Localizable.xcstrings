  "strings": {
    "%@ has no active Tibber subscription, so there are no prices.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har intet aktivt Tibber-abonnement, så der er ingen priser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat kein aktives Tibber-Abonnement, daher gibt es keine Preise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene una suscripción activa de Tibber, así que no hay precios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteella %@ ei ole aktiivista Tibber-tilausta, joten hintoja ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas d'abonnement Tibber actif, il n'y a donc pas de prix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha un abbonamento Tibber attivo, quindi non ci sono prezzi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ikke noe aktivt Tibber-abonnement, så det finnes ingen priser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft geen actief Tibber-abonnement, dus er zijn geen prijzen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen aktiv Tibber-prenumeration, så det finns inga priser."
          }
        }
      }
    },
