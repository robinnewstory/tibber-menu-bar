        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un jeton d'accès personnel sur developer.tibber.com sous Settings → Access Token, puis collez-le ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un token di accesso personale su developer.tibber.com in Settings → Access Token, poi incollalo qui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett et personlig tilgangstoken på developer.tibber.com under Settings → Access Token, og lim det inn her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een personal access token aan op developer.tibber.com onder Settings → Access Token en plak het hier."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en personlig åtkomsttoken på developer.tibber.com under Settings → Access Token och klistra in den här."
          }
        }
      }
    },
    "Create a personal access token on developer.tibber.com under Settings → Access Token, then paste it in this app's Settings. Prices appear in the menu bar right after.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret et personligt adgangstoken på developer.tibber.com under Settings → Access Token, og indsæt det i appens indstillinger. Priserne vises i menulinjen med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle auf developer.tibber.com unter Settings → Access Token ein Personal Access Token und füge es in den Einstellungen dieser App ein. Die Preise erscheinen direkt danach in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un token de acceso personal en developer.tibber.com en Settings → Access Token y pégalo en los ajustes de esta app. Los precios aparecen en la barra de menús enseguida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo henkilökohtainen käyttötunnus osoitteessa developer.tibber.com kohdassa Settings → Access Token ja liitä se tämän sovelluksen asetuksiin. Hinnat näkyvät valikkorivillä heti sen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un jeton d'accès personnel sur developer.tibber.com sous Settings → Access Token, puis collez-le dans les réglages de cette app. Les prix apparaissent aussitôt dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un token di accesso personale su developer.tibber.com in Settings → Access Token, poi incollalo nelle impostazioni di questa app. I prezzi compaiono subito nella barra dei menu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett et personlig tilgangstoken på developer.tibber.com under Settings → Access Token, og lim det inn i innstillingene til denne appen. Prisene vises i menylinjen rett etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een personal access token aan op developer.tibber.com onder Settings → Access Token en plak het in de instellingen van deze app. De prijzen verschijnen daarna meteen in de menubalk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en personlig åtkomsttoken på developer.tibber.com under Settings → Access Token och klistra in den i appens inställningar. Priserna visas i menyraden direkt efteråt."
          }
        }
      }
    },
