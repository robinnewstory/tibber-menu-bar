    "Your token is stored in the macOS Keychain and only ever sent to api.tibber.com.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit token gemmes i macOS-nøgleringen og sendes kun til api.tibber.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Token liegt im macOS-Schlüsselbund und wird ausschließlich an api.tibber.com gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu token se guarda en el llavero de macOS y solo se envía a api.tibber.com."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnuksesi tallennetaan macOS-avainnippuun ja lähetetään vain osoitteeseen api.tibber.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jeton est stocké dans le trousseau macOS et n'est envoyé qu'à api.tibber.com."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo token è salvato nel portachiavi di macOS e viene inviato solo a api.tibber.com."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokenet ditt lagres i macOS-nøkkelringen og sendes kun til api.tibber.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je token staat in de macOS-sleutelhanger en wordt alleen naar api.tibber.com gestuurd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din token lagras i macOS-nyckelringen och skickas bara till api.tibber.com."
          }
        }
      }
    },
